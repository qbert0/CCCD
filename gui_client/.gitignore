# --- Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# --- IDE & Editors (Cấu hình của trình sửa code) ---
.idea/
.vscode/
*.swp
*.swo

# --- PaddleOCR & AI Models (RẤT QUAN TRỌNG) ---
# Bỏ qua các folder model tải về (nặng)
inference/
*.pdparams
*.pdopt
*.pdmodel
.paddlex/

# Bỏ qua folder cache mặc định của Paddle
paddleocr/

# --- Logs & Debug Output ---
*.log
npm-debug.log*

# File ảnh debug mà code đã tạo ra (như mình đã thêm ở bước trước)
test_debug.jpg
test_debug.png

# Folder mặc định Paddle hay lưu kết quả
output/
result/

# --- Dữ liệu test (Bảo mật thông tin CCCD) ---
# Khuyên bạn nên tạo folder 'data' hoặc 'test_images' để chứa ảnh test
# và ignore nó đi để không lỡ tay commit ảnh CCCD lên mạng.
data/
test_images/
temp/

# Nếu bạn để ảnh test lung tung ở root, hãy uncomment dòng dưới (nhưng cẩn thận mất icon app)
# *.png
# *.jpg
# *.jpeg

# --- PyInstaller (Nếu đóng gói file .exe) ---
build/
dist/
*.spec

